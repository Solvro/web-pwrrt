    "lint:fix": "next lint --fix",
    "prepare": "husky || true",
    "seed": "node prisma/seed-team-member.js",
    "start": "next start",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "prettier": "@solvro/config/prettier",
  "overrides": {
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@payloadcms/db-mongodb": "^3.38.0",
    "@payloadcms/next": "^3.38.0",
    "@payloadcms/richtext-lexical": "^3.38.0",
    "@payloadcms/storage-s3": "^3.38.0",
    "@prisma/client": "^5.10.2",
    "@radix-ui/react-slot": "^1.2.2",
    "@react-google-maps/api": "^2.20.6",
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.1.2",
    "@tanstack/react-query": "^5.77.1",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "graphql": "^16.11.0",
    "knip": "^5.55.1",
    "motion": "^12.10.4",
    "next": "15.3.2",
    "next-auth": "^4.24.11",
    "next-cloudinary": "^6.16.0",
    "next-intl": "^4.1.0",
    "payload": "^3.38.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.56.3",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1",
    "sharp": "^0.34.1",
    "tailwind-merge": "^3.2.0",
    "three": "^0.176.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
