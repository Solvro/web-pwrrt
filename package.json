    "@solvro/config": "^1.13.5",
    "@tailwindcss/postcss": "^4.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "@types/three": "^0.176.0",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.35",
    "prettier": "3.5.3",
    "prisma": "^5.10.2",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seedTeamMember.js"
  }
