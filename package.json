{
  "name": "pwr-racing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && next build",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "knip": "knip",
    "lint": "next lint --max-warnings=0",
    "lint:fix": "next lint --fix",
    "prepare": "husky || true",
    "seed": "node prisma/seed-team-member.js",
    "start": "next start",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "prettier": "@solvro/config/prettier",
  "overrides": {
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.10.2",
    "@react-google-maps/api": "^2.20.6",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "knip": "^5.55.1",
    "motion": "^12.10.4",
    "next": "15.3.2",
    "next-auth": "^4.24.11",
    "next-cloudinary": "^6.16.0",
    "next-intl": "^4.1.0",
    "postcss-load-config": "^6.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.56.3",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1",
    "react-scroll": "^1.9.3",
    "react-transition-group": "^4.4.5",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-filters": "^3.0.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@next/eslint-plugin-next": "^15.3.2",
    "@solvro/config": "^1.13.5",
    "@tailwindcss/postcss": "^4.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "@types/react-scroll": "^1.8.10",
    "autoprefixer": "^10.4.17",
    "csvtojson": "^2.0.10",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.35",
    "prettier": "3.5.3",
    "prisma": "^5.10.2",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seedTeamMember.js"
  }
